{:deps
 {org.apache.kafka/kafka-clients {:mvn/version "4.1.0"}
  org.clojure/tools.logging      {:mvn/version "0.4.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps
         ;; Embedded broker for the integration tests. Kafka 4 dropped
         ;; ZooKeeper, so kafka_2.13 + curator-test cannot start a broker any
         ;; more; KafkaClusterTestKit (KRaft) lives here and pulls the server
         ;; side in by itself.
         {org.apache.kafka/kafka-test-common-runtime
          {:mvn/version "4.1.0"
           :exclusions  [org.slf4j/slf4j-log4j12 log4j/log4j]}

          org.clojure/core.async          {:mvn/version "0.4.474"}
          ch.qos.logback/logback-classic  {:mvn/version "1.2.3"}
          org.slf4j/log4j-over-slf4j      {:mvn/version "1.7.25"}}}
  :repl {:extra-deps
         {cider/cider-nrepl             {:mvn/version "0.28.5"}
          nrepl/nrepl                   {:mvn/version "0.9.0"}
          refactor-nrepl/refactor-nrepl {:mvn/version "3.5.3"}}
         :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
